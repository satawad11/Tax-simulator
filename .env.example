APP_NAME="Tax Simulator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
# Production: APP_ENV=production, APP_DEBUG=false, HTTPS APP_URL, and a unique APP_KEY.
APP_PORT=8088
TRUSTED_PROXIES=
BOOST_BROWSER_LOGS_WATCHER=false

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tax_simulator
DB_USERNAME=tax_user
DB_PASSWORD=tax_password
DB_ROOT_PASSWORD=local_root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PARTITIONED_COOKIE=false
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=tax-simulator-cache-

# Development default. Production MUST set a real transport: `log` writes the message to
# storage/logs and sends nothing, while password reset still answers 202 and raises no error.
# See docs/ops/PRODUCTION_READINESS_CHECKLIST.md.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Exact HTTPS first-party domains if Sanctum cookie authentication is enabled.
SANCTUM_STATEFUL_DOMAINS=localhost:8088
SANCTUM_TOKEN_PREFIX=

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5178

# Development seed accounts (local only).
# DevelopmentAccountSeeder refuses to run outside an approved development environment, and
# fails with a clear message when either value is empty — there is deliberately no default
# password. Set your own values locally; never commit real credentials.
DEV_ADMIN_PASSWORD=
DEV_USER_PASSWORD=
